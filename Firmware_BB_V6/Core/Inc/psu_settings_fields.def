/* name, integer wire scale, minimum, maximum, factory value */
PSU_FIELD(cv_kp, 1000000, 0.0f, 1.0f, PSU_CV_KP)
PSU_FIELD(cv_ki, 1000000, 0.0f, 20.0f, PSU_CV_KI)
PSU_FIELD(cv_kd, 1000000, 0.0f, 0.01f, 0.0f)
PSU_FIELD(cc_kp, 1000000, 0.0f, 1.0f, PSU_CC_KP)
PSU_FIELD(cc_ki, 1000000, 0.0f, 20.0f, PSU_CC_KI)
PSU_FIELD(cc_kd, 1000000, 0.0f, 0.01f, 0.0f)
PSU_FIELD(vin_min, 1000, PSU_VIN_MIN_V, 58.0f, PSU_VIN_MIN_V)
PSU_FIELD(vin_max, 1000, 8.0f, PSU_VIN_MAX_V, PSU_VIN_MAX_V)
PSU_FIELD(vin_warn, 1000, PSU_VIN_MIN_V, PSU_VIN_MAX_V, PSU_VIN_WARN_V)
PSU_FIELD(vout_max, 1000, PSU_VOUT_MIN_V, PSU_VOUT_MAX_V, PSU_VOUT_MAX_V)
PSU_FIELD(i_max, 1000, 0.1f, PSU_CURRENT_MAX_A, PSU_CURRENT_MAX_A)
PSU_FIELD(i_peak, 1000, 0.2f, PSU_CURRENT_PEAK_A, PSU_CURRENT_PEAK_A)
PSU_FIELD(power_max, 1000, 1.0f, PSU_POWER_MAX_W, PSU_POWER_MAX_W)
PSU_FIELD(input_current_max, 1000, 0.1f, PSU_INPUT_CURRENT_MAX_A, PSU_INPUT_CURRENT_MAX_A)
PSU_FIELD(efficiency, 1000, 0.5f, 0.95f, PSU_EFFICIENCY_ESTIMATE)
PSU_FIELD(temp_warn, 10, 30.0f, 80.0f, PSU_TEMP_WARN_C)
PSU_FIELD(temp_trip, 10, 35.0f, PSU_TEMP_TRIP_C, PSU_TEMP_TRIP_C)
PSU_FIELD(temp_reset, 10, 20.0f, 75.0f, PSU_TEMP_RESET_C)
PSU_FIELD(ovp_percent, 1000, 1.0f, 10.0f, 5.0f)
PSU_FIELD(ovp_offset, 1000, 0.05f, 1.0f, 0.5f)
PSU_FIELD(vdda, 1000, 2.7f, 3.6f, PSU_VDDA_V)
PSU_FIELD(vin_cal, 1000000, 0.8f, 1.2f, PSU_VIN_CAL)
PSU_FIELD(vout_cal, 1000000, 0.8f, 1.2f, PSU_VOUT_CAL)
PSU_FIELD(i_cal, 1000000, 0.5f, 1.5f, PSU_CURRENT_CAL)
PSU_FIELD(i_offset, 1000000, -0.05f, 0.25f, PSU_CURRENT_OFFSET_V)
PSU_FIELD(adc_alpha, 1000000, 0.02f, 0.5f, 0.25f)
PSU_FIELD(ntc_r25, 1, 1000.0f, 1000000.0f, PSU_NTC_R25_OHM)
PSU_FIELD(ntc_pull, 1, 1000.0f, 1000000.0f, PSU_NTC_PULL_OHM)
PSU_FIELD(ntc_beta, 1, 1000.0f, 6000.0f, PSU_NTC_BETA_K)
PSU_FIELD(ntc_to_gnd, 1, 0.0f, 1.0f, PSU_NTC_TO_GND)
PSU_FIELD(discharge_enabled, 1, 0.0f, 1.0f, PSU_DISCHARGE_ENABLED)
PSU_FIELD(discharge_peak, 1000, 0.1f, PSU_DISCHARGE_EST_PEAK_A, PSU_DISCHARGE_EST_PEAK_A)
PSU_FIELD(discharge_interval, 1, PSU_DISCHARGE_INTERVAL_MS, 1000.0f, PSU_DISCHARGE_INTERVAL_MS)
PSU_FIELD(discharge_on_us, 1, 2.0f, PSU_DISCHARGE_MAX_ON_US, PSU_DISCHARGE_MAX_ON_US)
PSU_FIELD(discharge_stop, 1000, PSU_DISCHARGE_STOP_V, 2.0f, PSU_DISCHARGE_STOP_V)
PSU_FIELD(discharge_timeout, 1, 1000.0f, PSU_DISCHARGE_MAX_MS, PSU_DISCHARGE_MAX_MS)
/* Append only: the first 36 floats retain the Flash V2 layout. */
PSU_FIELD(ramp_v_per_s, 1000, 0.1f, 100.0f, PSU_RAMP_V_PER_S)
/* V4 append: common solder supply profile, independent of LAB setpoints. */
PSU_FIELD(solder_voltage, 1000, PSU_VOUT_MIN_V, PSU_VOUT_MAX_V, 18.0f)
PSU_FIELD(solder_current, 1000, 0.05f, PSU_CURRENT_MAX_A, 6.0f)
